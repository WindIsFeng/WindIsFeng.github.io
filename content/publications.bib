  author = {Zhitong Lv and Fa Li and Hao Wang and Shitang Ke and Xu Hong and Feng Hu and Tongguang Wang},
  year = {2026},
  month = may,
  journal = {Engineering Structures},
  volume = {361},
  pages = {122882},
  doi = {10.1016/j.engstruct.2026.122882},
  keywords = {Floating offshore wind turbine, Typhoon, Wind-wave misalignment, Wind shift, Dynamic response},
  description = {Quantifies how rapid typhoon wind shifts and wind-wave misalignment affect floating offshore wind turbine dynamic responses.},
  abstract = {This study introduces a floating offshore wind turbine dynamics model and evaluates wind-wave misalignment caused by rapid typhoon wind shifts. The results indicate that 30-degree and 60-degree misalignment conditions should be considered as key load cases for typhoon-resistant design.}
}

