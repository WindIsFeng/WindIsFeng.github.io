@misc{hu2026cityscale,
  sort_order = {1},
  preview = {cityscale.png},
  title = {From global AI forecasts to city-scale extreme winds},
  author = {Feng Hu# and Maozeng Yang# and Xiaotian Zhang and Fei Wang and Yuxin Zhang and Kang Xu and Zeyi Niu and Shengming Tang and Junyi He and Pak-Wai Chan and Qiusheng Li},
  year = {2026},
  journal = {Manuscript under review},
  keywords = {Artificial intelligence, Weather forecasting, Tropical cyclone, City-scale winds, WRF-UCM},
  description = {Under review. An AI-physics hybrid framework couples global AI weather prediction models with WRF-UCM to forecast city-scale extreme winds during tropical cyclones.},
  abstract = {Rapid advances in global AI weather prediction offer new opportunities for efficient tropical cyclone forecasting, yet their coarse resolution limits direct prediction of urban extreme winds. This study presents an AI-physics hybrid framework that couples five AI weather prediction models with Weather Research and Forecasting-Urban Canopy Model for high-resolution city-scale extreme wind forecasting.}
}

@misc{hu2026globalhazard,
  sort_order = {2},
  preview = {globalhazard.png},
  title = {Global tropical cyclone wind hazard assessment with a generative transformer},
  author = {Feng Hu and Jian Yang and Qiusheng Li},
  year = {2026},
  journal = {Manuscript under review},
  keywords = {Tropical cyclone, Natural hazards, Artificial intelligence, Risk assessment},
  description = {Under review. A generative transformer-based framework produces long synthetic tropical cyclone track ensembles for global wind hazard assessment.},
  abstract = {This paper presents a framework for global tropical cyclone wind hazard assessment based on a generative pre-trained transformer. A decoder-only transformer is trained on historical best-track records to learn the joint evolution of storm translation and intensity and generate a large synthetic ensemble equivalent to over 10,000 years of tracks.}
}

