  title = {Projection of tropical cyclone genesis under climate change with convolutional mixing neural networks},
  author = {Feng Hu and Qiusheng Li},
  year = {2026},
  month = nov,
  journal = {Atmospheric Research},
  volume = {330},
  pages = {108610},
  doi = {10.1016/j.atmosres.2025.108610},
  keywords = {Deep learning, Tropical cyclone genesis, Natural hazards, Climate change},
  description = {Develops a convolutional mixing neural network to project tropical cyclone genesis in the western North Pacific under climate change.},
  abstract = {This paper presents a deep learning-based model designed to predict the spatial and temporal distribution of tropical cyclone genesis in the western North Pacific under climate change. The model incorporates spatial and channel mixing techniques and suggests a weak long-term decline in tropical cyclone frequency across the basin, with potential increases in the South China Sea under high-emission scenarios.}
}

