@article{hu2024basin,
  sort_order = {7},
  selected = {true},
  preview = {basin.png},
  title = {An environment-driven basin scale tropical cyclone model},
  author = {Feng Hu and Qiusheng Li and Xu Hong},
  year = {2024},
  month = may,
  journal = {Structural Safety},
  volume = {109},
  pages = {102480},
  doi = {10.1016/j.strusafe.2024.102480},
  keywords = {Tropical cyclone, Natural hazard, Risk analysis, Joint distribution},
  description = {Introduces an environment-driven tropical cyclone model for basin-scale risk analysis in the western North Pacific.},
  abstract = {This paper presents an environment-driven tropical cyclone model for the western North Pacific basin, including a revised Poisson regression genesis model, a tailored beta-advection track model, and a fast intensity model. Risk analyses for Hong Kong and the southeast coastline of mainland China demonstrate its capability for simulating extreme tropical cyclone events.}
}
